@@ -0,0 +1,155 @@
+#include "components/viz/service/display_embedder/software_output_device_proxy.h"
+
+#include "base/memory/unsafe_shared_memory_region.h"
+#include "base/logging.h"
+#include "base/threading/thread_checker.h"
