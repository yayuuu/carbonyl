+void ResizeWindow(BrowserWindowInterface* window, gfx::Size size) {
+
+  if (!window) return;
+  // Resize the native display host without BrowserView::SetBounds, which exits
+  // fullscreen. Resizing only WebContents is undone on the next navigation.
+  auto* native = window->GetWindow()->GetNativeWindow();
+  if (native && native->GetHost()) {
+    native->GetHost()->SetBoundsInPixels(
+        gfx::Rect(gfx::ScaleToCeiledSize(size, Bridge::GetDPI())));
+  } else if (!window->GetWindow()->IsFullscreen()) {
+    window->GetWindow()->SetBounds(gfx::Rect(size));
+  }
+  auto* tab=window->GetActiveTabInterface();
+  if (auto* contents=tab ? tab->GetContents() : nullptr) {
+    contents->Resize(gfx::Rect(size));
+    if (auto* view = contents->GetRenderWidgetHostView()) {
+      view->SetSize(size);
+      view->Focus();
+    }
+  }
+}
