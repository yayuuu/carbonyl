+};
+class Sessions final : public BrowserCollectionObserver {
+ public:
+  void Start(const char* path) {
+    profile_=ActiveWindow()->GetProfile();
+    observation_.Observe(GlobalBrowserCollection::GetInstance());
+    GlobalBrowserCollection::GetInstance()->ForEach([this](BrowserWindowInterface* window){Track(window);return true;});
+    socket_path_=path;
+    int listener=socket(AF_UNIX,SOCK_STREAM|SOCK_CLOEXEC,0);
+    listener_=listener;
+    CHECK_GE(listener,0);
+    sockaddr_un address{}; address.sun_family=AF_UNIX;
+    CHECK_LT(strlen(path),sizeof(address.sun_path)); strcpy(address.sun_path,path);
+    CHECK_EQ(bind(listener,reinterpret_cast<sockaddr*>(&address),sizeof(address)),0);
+    CHECK_EQ(chmod(path,0600),0);CHECK_EQ(listen(listener,16),0);
+    auto runner=base::SingleThreadTaskRunner::GetCurrentDefault();
+    std::thread([this,listener,runner]{
+      base::ScopedFD owned_listener(listener);
+      while (!stopping_) {
+        int fd=accept4(listener,nullptr,nullptr,SOCK_CLOEXEC);
+        if (fd<0) {if(stopping_)break;continue;}
+        if (stopping_) {close(fd);break;}
+        std::thread([this,fd,runner]{
+          auto connection=std::make_shared<Connection>(fd);
+          ucred peer{}; socklen_t length=sizeof(peer);
+          if (getsockopt(fd,SOL_SOCKET,SO_PEERCRED,&peer,&length)!=0 || peer.uid!=getuid()) return;
+          timeval timeout{30,0};setsockopt(fd,SOL_SOCKET,SO_RCVTIMEO,&timeout,sizeof(timeout));
+          unsigned char header[20]{};alignas(cmsghdr) char ancillary[CMSG_SPACE(sizeof(int))]{};
+          iovec vector{header,sizeof(header)};msghdr message{};
+          message.msg_iov=&vector;message.msg_iovlen=1;message.msg_control=ancillary;message.msg_controllen=sizeof(ancillary);
+          ssize_t got=recvmsg(fd,&message,MSG_WAITALL|MSG_CMSG_CLOEXEC);
+          if (got!=sizeof(header)) return;
+          for (auto* c=CMSG_FIRSTHDR(&message);c;c=CMSG_NXTHDR(&message,c)) {
+            if (c->cmsg_level==SOL_SOCKET && c->cmsg_type==SCM_RIGHTS && c->cmsg_len==CMSG_LEN(sizeof(int))) {
+              int tty;memcpy(&tty,CMSG_DATA(c),sizeof(tty));connection->terminal.reset(tty);
+            }
+          }
+          uint32_t size=0;uint64_t id=0;memcpy(&size,header+8,4);memcpy(&id,header+12,8);
+          if (memcmp(header,"CBTW0001",8)!=0 || size>65536 || !connection->terminal.is_valid() || !isatty(connection->terminal.get())) return;
+          std::string url(size,'\0');size_t pos=0;
+          while (pos<size) {ssize_t n=recv(fd,url.data()+pos,size-pos,0);if(n<=0)return;pos+=n;}
+          timeout={0,0};setsockopt(fd,SOL_SOCKET,SO_RCVTIMEO,&timeout,sizeof(timeout));
+          runner->PostTask(FROM_HERE,base::BindOnce(&Sessions::Attach,base::Unretained(this),connection,id,std::move(url)));
+          char ignored;while (recv(fd,&ignored,1,0)>0) {}
+          runner->PostTask(FROM_HERE,base::BindOnce(&Sessions::Disconnected,base::Unretained(this),connection));
+        }).detach();
+      }
+    }).detach();
+  }
+  void OnBrowserCreated(BrowserWindowInterface* window) override {
+    Track(window);
+    if (attaching_) return;
+    auto id=window->GetSessionID().id();
+    // Delay until the new browser has its first WebContents and native window.
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(FROM_HERE,base::BindOnce(&Sessions::LaunchFrontend,base::Unretained(this),id));
+  }
+  void OnBrowserClosed(BrowserWindowInterface* window) override {
+    int id=window->GetSessionID().id();
+    auto it=connections_.find(id);
+    if (it!=connections_.end()) {
+      auto c=it->second;connections_.erase(it);
+      StopBrowserInput(renderers_[id]);renderers_.erase(id);
+      bool last=connections_.empty() && GlobalBrowserCollection::GetInstance()->GetSize()==0;
+      if(last) {
+        stopping_=true;
+        // Stop accepting frontends before reporting the last window closed.
+        // A subsequent launch must start a fresh engine, not attach during
+        // profile teardown after Chromium releases its singleton lock.
+        unlink(socket_path_.c_str());shutdown(listener_,SHUT_RDWR);
+      }
+      char code=last ? 'L':'Q';
+      send(c->socket.get(),&code,1,MSG_NOSIGNAL);shutdown(c->socket.get(),SHUT_RDWR);
+    }
+    tabs_.erase(id);
+  }
+ private:
+  BrowserWindowInterface* Find(uint64_t id) {
+    BrowserWindowInterface* result=nullptr;
+    GlobalBrowserCollection::GetInstance()->ForEach([&](BrowserWindowInterface* w){if(static_cast<uint64_t>(w->GetSessionID().id())==id){result=w;return false;}return true;});
+    return result;
+  }
+  void Track(BrowserWindowInterface* window) {tabs_[window->GetSessionID().id()]=std::make_unique<WindowTabs>(window);}
+  void Attach(std::shared_ptr<Connection> connection,uint64_t id,std::string url) {
+    if(stopping_) {shutdown(connection->socket.get(),SHUT_RDWR);return;}
+    BrowserWindowInterface* window=nullptr;
+    if(id) window=Find(id);
+    else {
+      GlobalBrowserCollection::GetInstance()->ForEach([&](BrowserWindowInterface* w){if(!connections_.contains(w->GetSessionID().id())){window=w;return false;}return true;});
+      if(!window) {attaching_=true;window=chrome::OpenEmptyWindow(profile_,false);attaching_=false;}
+    }
+    if(!window || connections_.contains(window->GetSessionID().id())) {shutdown(connection->socket.get(),SHUT_RDWR);return;}
+    int key=window->GetSessionID().id();connection->window=key;connections_[key]=connection;
+    if (!window->GetWindow()->IsFullscreen()) chrome::ToggleFullscreenMode(window, false);
+    auto* renderer=Renderer::CreateTerminal(connection->terminal.get());renderers_[key]=renderer;
+    auto* native=window->GetWindow()->GetNativeWindow();
+    if(!native || !native->GetHost()) {window->GetWindow()->Close();return;}
+    renderer->BindWidget(native->GetHost()->GetAcceleratedWidget());
+    Renderer::Scope scope(renderer,true);renderer->StartRenderer();
+    auto weak=window->GetWeakPtr();
+    BrowserInputClient client;
+    client.pages=base::BindRepeating([](base::WeakPtr<BrowserWindowInterface> w){
+      auto* tab=w && !w->IsDeleteScheduled() ? w->GetActiveTabInterface() : nullptr;
+      return tab ? std::vector<content::WebContents*>{tab->GetContents()} : std::vector<content::WebContents*>{};
+    },weak);
+    client.resize=base::BindRepeating([](base::WeakPtr<BrowserWindowInterface> w,gfx::Size size){if(w && !w->IsDeleteScheduled())ResizeWindow(w.get(),size);},weak);
+    client.shutdown=base::BindRepeating([](base::WeakPtr<BrowserWindowInterface> w){if(w && !w->IsDeleteScheduled())w->GetWindow()->Close();},weak);
+    client.focus=base::BindRepeating([](base::WeakPtr<BrowserWindowInterface> w){
+      if(w && !w->IsDeleteScheduled())w->GetWindow()->Activate();
+    },weak);
+    client.dialog_action=base::BindRepeating(&NativeDialogAction);
+    client.clipboard_sync=base::BindRepeating(&SessionClipboardReply);
+    StartBrowserInput(std::move(client));ResizeWindow(window,renderer->GetSize());
+    ReplayTerminalText(renderer);
+    if(auto* host=native->GetHost())if(auto* compositor=host->compositor())compositor->ScheduleFullRedraw();
+    if(auto* tab=window->GetActiveTabInterface()){
+      ObserveAddress(tab->GetContents()); if(!id)OpenAddress(tab->GetContents(),url);
+    }
+    char ok='O';send(connection->socket.get(),&ok,1,MSG_NOSIGNAL);
+  }
+  void Disconnected(std::shared_ptr<Connection> c) {
+    auto it=connections_.find(c->window);
+    if(it!=connections_.end() && it->second==c)if(auto* w=Find(c->window)) {
+      // A vanished terminal cannot answer before-unload questions. Destroy
+      // only its page; other windows and the shared profile remain alive.
+      auto weak=w->GetWeakPtr();
+      while(weak && !weak->IsDeleteScheduled() && weak->GetTabStripModel()->count()>0)
+        weak->GetTabStripModel()->DetachAndDeleteWebContentsAt(weak->GetTabStripModel()->count()-1);
+      if(weak && !weak->IsDeleteScheduled())weak->GetWindow()->Close();
+    }
+  }
+  void LaunchFrontend(int id) {
+    if(!Find(id) || connections_.contains(id))return;
+    const auto program=base::CommandLine::ForCurrentProcess()->GetProgram();
+    base::CommandLine helper(base::FilePath("/usr/bin/python3"));
+    helper.AppendArgPath(program.DirName().Append("carbonyl-file-portal.py"));
+    helper.AppendArg("--open-window");helper.AppendArg(std::to_string(id));
+    helper.AppendArgPath(profile_->GetPath().DirName());helper.AppendArgPath(program);
+    base::LaunchProcess(helper,base::LaunchOptions());
+  }
+  raw_ptr<Profile> profile_=nullptr;
+  std::atomic<bool> stopping_{false};
+  int listener_=-1;
+  std::string socket_path_;
+  bool attaching_=false;
+  std::map<int,std::unique_ptr<WindowTabs>> tabs_;
+  std::map<int,std::shared_ptr<Connection>> connections_;
+  std::map<int,Renderer*> renderers_;
+  base::ScopedObservation<GlobalBrowserCollection,BrowserCollectionObserver> observation_{this};
+};
+}  // namespace
+
+void StartChromeBrowserInput() {
+  auto initial=display::Screen::Get()->GetPrimaryDisplay();
+  initial.SetScaleAndBounds(Bridge::GetDPI(), gfx::Rect(gfx::ScaleToCeiledSize(Renderer::GetCurrent()->GetSize(),Bridge::GetDPI())));
+  display::HeadlessScreenManager::Get()->UpdateDisplay(initial);
+  InstallPortalFileDialog();InstallNativeDialogs();InstallSessionClipboard();
+  if(auto* window=ActiveWindow()){
+    static base::NoDestructor<DownloadStatus> downloads;downloads->Install(window->GetProfile()->GetDownloadManager());
+    auto* prefs=window->GetProfile()->GetPrefs();
+    prefs->SetBoolean(password_manager::prefs::kCredentialsEnableService,false);
+    prefs->SetBoolean(prefs::kPromptForDownload,true);
+  }
+  if(const char* path=std::getenv("CARBONYL_SESSION_SOCKET")) {
+    static base::NoDestructor<Sessions> sessions;sessions->Start(path);return;
+  }
+  // Compatibility for direct shell-mode launches.
+  auto* renderer=Renderer::GetCurrent();
+  if(auto* window=ActiveWindow())if(auto* native=window->GetWindow()->GetNativeWindow())renderer->BindWidget(native->GetHost()->GetAcceleratedWidget());
+  renderer->StartRenderer();
+  BrowserInputClient client;
+  client.pages=base::BindRepeating(&ActivePages);
+  client.resize=base::BindRepeating([](gfx::Size size){ResizeWindow(ActiveWindow(),size);});
+  client.shutdown=base::BindRepeating(&chrome::AttemptExit);
+  client.dialog_action=base::BindRepeating(&NativeDialogAction);
+  client.clipboard_sync=base::BindRepeating(&SessionClipboardReply);
+  StartBrowserInput(std::move(client));ResizeWindow(ActiveWindow(),renderer->GetSize());
+  auto pages=ActivePages();if(!pages.empty())ObserveAddress(pages.front());
+}
