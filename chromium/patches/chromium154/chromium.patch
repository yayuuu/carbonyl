+// Track real Chromium download items. Terminal overlays are window-local and
+// leave the page layout untouched; completed/failed downloads expire after 5s.
+class DownloadStatus final : public content::DownloadManager::Observer,
+                             public download::DownloadItem::Observer {
+ public:
+  void Install(content::DownloadManager* manager) {manager->AddObserver(this);}
+  void OnDownloadCreated(content::DownloadManager*,download::DownloadItem* item) override {
+    if(item->GetState()!=download::DownloadItem::IN_PROGRESS)return;
+    item->AddObserver(this);items_[item]={};
+    Update(item);
+    if(!timer_.IsRunning())timer_.Start(FROM_HERE,base::Milliseconds(250),base::BindRepeating(&DownloadStatus::Tick,base::Unretained(this)));
+  }
+  void OnDownloadUpdated(download::DownloadItem* item) override {Update(item);}
+  void OnDownloadDestroyed(download::DownloadItem* item) override {items_.erase(item);Tick();}
+  void ManagerGoingDown(content::DownloadManager* manager) override {
+    timer_.Stop();for(auto& [item,state]:items_)item->RemoveObserver(this);
+    items_.clear();last_.clear();manager->RemoveObserver(this);
+  }
+ private:
+  struct State {raw_ptr<Renderer> renderer=nullptr; base::TimeTicks expires;};
+  void Update(download::DownloadItem* item) {
+    auto& state=items_[item];
+    if(!state.renderer) {
+      auto* contents=content::DownloadItemUtils::GetWebContents(item);
+      if(!contents)contents=content::DownloadItemUtils::GetOriginalWebContents(item);
+      if(contents)state.renderer=RendererForContents(contents);
+    }
+    if(item->GetState()==download::DownloadItem::IN_PROGRESS)state.expires={};
+    else if(state.expires.is_null())state.expires=base::TimeTicks::Now()+base::Seconds(5);
+  }
+  static std::string Bytes(int64_t bytes) {
+    if(bytes>=1024*1024)return base::StringPrintf("%.1f MiB",bytes/(1024.0*1024.0));
+    if(bytes>=1024)return base::StringPrintf("%.1f KiB",bytes/1024.0);
+    return base::StringPrintf("%lld B",static_cast<long long>(bytes));
+  }
+  void Tick() {
+    auto now=base::TimeTicks::Now();
+    for(auto it=items_.begin();it!=items_.end();) {
+      if(!it->second.expires.is_null() && now>=it->second.expires) {it->first->RemoveObserver(this);it=items_.erase(it);}
+      else {Update(it->first);++it;}
+    }
+    std::map<Renderer*,download::DownloadItem*> chosen;
+    std::map<Renderer*,int> counts;
+    for(auto& [item,state]:items_)if(state.renderer) {
+      auto* renderer=state.renderer.get();
+      if(item->GetState()==download::DownloadItem::IN_PROGRESS)++counts[renderer];
+      auto it=chosen.find(renderer);
+      if(it==chosen.end() || (item->GetState()==download::DownloadItem::IN_PROGRESS && it->second->GetState()!=download::DownloadItem::IN_PROGRESS) ||
+         (item->GetState()==it->second->GetState() && item->GetStartTime()>it->second->GetStartTime()))chosen[renderer]=item;
+    }
+    std::map<Renderer*,std::string> next;
+    for(auto& [renderer,item]:chosen) {
+      auto name=item->GetFileNameToReportUser().AsUTF8Unsafe();
+      if(name.empty())name=item->GetSuggestedFilename();
+      std::string text;
+      if(item->GetState()==download::DownloadItem::COMPLETE)text="Pobrano: "+name+" | "+Bytes(item->GetReceivedBytes());
+      else if(item->GetState()==download::DownloadItem::CANCELLED)text="Anulowano: "+name;
+      else if(item->GetState()==download::DownloadItem::INTERRUPTED)text="Przerwano pobieranie: "+name;
+      else {
+        int percent=item->PercentComplete();
+        text=item->IsPaused()?"Pauza: ":"Pobieranie: ";
+        if(counts[renderer]>1)text+="("+std::to_string(counts[renderer])+") ";
+        if(percent>=0)text+=std::to_string(percent)+"% ";
+        text+=Bytes(item->GetReceivedBytes());
+        if(item->GetTotalBytes()>0)text+=" / "+Bytes(item->GetTotalBytes());
+        text+=" | "+name;
+      }
+      next[renderer]=std::move(text);
+    }
+    for(auto& [renderer,text]:last_)if(!next.contains(renderer))renderer->SetDownloadStatus("");
+    for(auto& [renderer,text]:next)if(!last_.contains(renderer) || last_[renderer]!=text)renderer->SetDownloadStatus(text);
+    last_=std::move(next);if(items_.empty())timer_.Stop();
+  }
+  std::map<download::DownloadItem*,State> items_;
+  std::map<Renderer*,std::string> last_;
+  base::RepeatingTimer timer_;
+};
