+namespace views {
+class CarbonylDialogPresenter {
+ public:
+  CarbonylDialogPresenter() : observer_(AnyWidgetPasskey{}) {
+    observer_.set_shown_callback(base::BindRepeating(
+        &CarbonylDialogPresenter::Shown, base::Unretained(this)));
+    observer_.set_hidden_callback(base::BindRepeating(
+        &CarbonylDialogPresenter::Removed, base::Unretained(this)));
+    observer_.set_closing_callback(base::BindRepeating(
+        &CarbonylDialogPresenter::Removed, base::Unretained(this)));
+    timer_.Start(FROM_HERE, base::Milliseconds(150), base::BindRepeating(
+        &CarbonylDialogPresenter::Refresh, base::Unretained(this)));
+  }
+  void Action(uint64_t id, int control, int action, const std::string& value) {
+    auto& state=states_[carbonyl::Renderer::GetCurrent()];
+    if (id != state.serial_ || state.widgets_.empty() || !state.widgets_.back()) return;
+    auto widget = state.widgets_.back();
+    if (action == 2) { // Escape/close: preserve Chromium's cancellation callback.
+      widget->CloseWithReason(Widget::ClosedReason::kEscKeyPressed);
+      return;
+    }
+    if (control <= 0 || static_cast<size_t>(control) > state.tracked_.size()) return;
+    auto* view = state.tracked_[control - 1]->view();
+    if (!view || !view->GetEnabledInViewsSubtree()) return;
+    auto choice=state.choices_.find(control);
+    if (action==0 && choice!=state.choices_.end()) {
+      if (auto* combo=AsViewClass<Combobox>(view)) {
+        if (choice->second<combo->GetModel()->GetItemCount() && combo->GetModel()->IsItemEnabledAt(choice->second))
+          combo->MenuSelectionAt(choice->second);
+      } else if (auto* table=AsViewClass<TableView>(view)) {
+        if (choice->second<table->GetRowCount()) table->Select(choice->second);
+      }
+    } else if (action == 1) {
+      auto* field = AsViewClass<Textfield>(view);
+      if (!field || field->GetReadOnly()) return;
+      // Unlike SetText alone, this also tells the dialog controller about the
+      // user's edit (validation, enabled buttons and authentication inputs).
+      field->SelectAll(false);
+      field->InsertOrReplaceText(base::UTF8ToUTF16(value));
+    } else if (action == 0) {
+      if (auto* button = AsViewClass<Button>(view))
+        button->AcceleratorPressed(ui::Accelerator(ui::VKEY_SPACE, ui::EF_NONE));
+    }
+    // Actions may synchronously delete the View or the entire Widget.
+    Refresh();
+  }
+ private:
+  struct State {
+    std::vector<base::WeakPtr<Widget>> widgets_;
+    base::WeakPtr<Widget> current_;
+    std::vector<std::unique_ptr<ViewTracker>> tracked_;
+    std::map<int,size_t> choices_;
+    uint64_t serial_ = 0;
+    bool shown_ = false;
+  };
+  struct Entry { int id, kind; std::string label, value; unsigned flags; };
+  void Shown(Widget* widget) {
+    auto* delegate = widget->widget_delegate();
+    // Browser windows, tooltips, web content and context menus stay on their
+    // own path. All real Views dialog and bubble delegates share this adapter.
+    if (!delegate || !delegate->AsDialogDelegate()) return;
+    // A bubble can have a separate native host. Follow its transient owner
+    // before considering that host, so another active terminal cannot steal it.
+    auto* renderer = Owner(widget);
+    if (auto* layer = widget->GetLayer()) layer->SetOpacity(0.f);
+    if (!renderer && std::getenv("CARBONYL_SESSION_SOCKET")) {
+      pending_.push_back(widget->GetWeakPtr());
+      return;  // Its window is still waiting for a terminal frontend.
+    }
+    if (!renderer) renderer=carbonyl::Renderer::GetCurrent();
+    auto& state=states_[renderer];
+    if (std::ranges::any_of(state.widgets_, [widget](const auto& w) { return w.get() == widget; })) return;
+    state.widgets_.push_back(widget->GetWeakPtr());
+    // Keep the actual widget alive and logically visible for Chrome. Only its
+    // graphical layer is hidden; Carbonyl paints the equivalent terminal UI.
+    if (auto* layer = widget->GetLayer()) layer->SetOpacity(0.f);
+    Refresh();
+  }
+  carbonyl::Renderer* Owner(Widget* widget) {
+    auto* primary=widget->GetPrimaryWindowWidget();
+    auto* native=primary ? primary->GetNativeWindow() : widget->GetNativeWindow();
+    auto* client=aura::client::GetTransientWindowClient();
+    for (int depth=0; native && depth<32; ++depth) {
+      if (client) if(auto* parent=client->GetTransientParent(native)) {native=parent;continue;}
+      auto* host=native->GetRootWindow()->GetHost();
+      return host ? carbonyl::Renderer::ForWidget(host->GetAcceleratedWidget()) : nullptr;
+    }
+    return nullptr;
+  }
+  void Removed(Widget* widget) {
+    std::erase_if(pending_,[widget](const auto& w){return !w || w.get()==widget;});
+    for(auto& [renderer,state]:states_) std::erase_if(state.widgets_, [widget](const auto& w) { return !w || w.get() == widget; });
+    // Visibility can change synchronously inside Widget::Show/Close.
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(FROM_HERE,
+        base::BindOnce(&CarbonylDialogPresenter::Refresh, base::Unretained(this)));
+  }
+  int Track(State& state, View* view) {
+    for (size_t i = 0; i < state.tracked_.size(); ++i)
+      if (state.tracked_[i]->view() == view && !state.choices_.contains(static_cast<int>(i+1))) return static_cast<int>(i + 1);
+    state.tracked_.push_back(std::make_unique<ViewTracker>(view));
+    return static_cast<int>(state.tracked_.size());
+  }
+  int TrackChoice(State& state, View* view, size_t row) {
+    for (const auto& [id,choice]:state.choices_)
+      if(choice==row && state.tracked_[id-1]->view()==view)return id;
+    state.tracked_.push_back(std::make_unique<ViewTracker>(view));
+    int id=static_cast<int>(state.tracked_.size());state.choices_[id]=row;return id;
+  }
+  void Collect(State& state, View* view, std::vector<Entry>& entries, View* focused) {
+    if (!view->GetVisible()) return;
+    ui::AXNodeData ax;
+    view->GetViewAccessibility().GetAccessibleNodeData(&ax);
+    auto label = ax.GetStringAttribute(ax::mojom::StringAttribute::kName);
+    unsigned flags = view->GetEnabledInViewsSubtree() ? 1 : 0;
+    if (view == focused) flags |= 8;
+    if (auto* combo=AsViewClass<Combobox>(view)) {
+      if (!label.empty()) entries.push_back({0,0,label,"",0});
+      auto* model=combo->GetModel();
+      for(size_t row=0;row<model->GetItemCount();++row) {
+        if(model->IsItemSeparatorAt(row))continue;
+        auto caption=(combo->GetSelectedIndex()==row ? "(●) " : "( ) ")+base::UTF16ToUTF8(model->GetItemAt(row));
+        entries.push_back({TrackChoice(state,view,row),1,caption,"",model->IsItemEnabledAt(row)?flags:0});
+      }
+      return;
+    }
+    if (auto* table=AsViewClass<TableView>(view)) {
+      if (!label.empty()) entries.push_back({0,0,label,"",0});
+      for(size_t row=0;row<table->GetRowCount();++row) {
+        auto caption=(table->selection_model().IsSelected(row)?"(●) ":"( ) ")+base::UTF16ToUTF8(table->model()->GetAXNameForRow(row,table->GetVisibleColumnIds()));
+        entries.push_back({TrackChoice(state,view,row),1,caption,"",flags});
+      }
+      return;
+    }
+    if (auto* field = AsViewClass<Textfield>(view)) {
+      if (!field->GetReadOnly()) {
+        if (field->GetTextInputType() == ui::TEXT_INPUT_TYPE_PASSWORD) flags |= 4;
+        entries.push_back({Track(state,view), 3, label, base::UTF16ToUTF8(field->GetText()), flags});
+        return;
+      }
+    }
+    if (auto* checkbox = AsViewClass<Checkbox>(view)) {
+      if (checkbox->GetChecked()) flags |= 2;
+      entries.push_back({Track(state,view), 2, label, "", flags});
+      return;
+    }
+    if (AsViewClass<Button>(view)) {
+      if (!label.empty()) entries.push_back({Track(state,view), 1, label, "", flags});
+      return;
+    }
+    if (auto* text = AsViewClass<Label>(view)) {
+      std::string value = base::UTF16ToUTF8(text->GetText());
+      if (!value.empty()) entries.push_back({0, 0, value, "", 0});
+      return;
+    }
+    for (const auto& child : view->children()) Collect(state,child.get(), entries, focused);
+  }
+  void Refresh() {
+    auto pending=std::move(pending_);pending_.clear();
+    for(auto& widget:pending) if(widget && !widget->IsClosed() && widget->IsVisible()) {
+      if(Owner(widget.get())) Shown(widget.get());
+      else pending_.push_back(widget);
+    }
+    for(auto& [renderer,state]:states_) RefreshOne(renderer,state);
+  }
+  void RefreshOne(carbonyl::Renderer* renderer, State& state) {
+    std::erase_if(state.widgets_, [](const auto& w) { return !w || w->IsClosed(); });
+    auto* widget = state.widgets_.empty() ? nullptr : state.widgets_.back().get();
+    if (state.current_.get() != widget) {
+      state.current_ = widget ? widget->GetWeakPtr() : base::WeakPtr<Widget>();
+      state.tracked_.clear();state.choices_.clear();
+      state.serial_=++serial_;
+    }
+    if (!widget) {
+      if (state.shown_) renderer->ShowDialog(0, "", {});
+      state.shown_ = false;
+      return;
+    }
+    std::vector<Entry> entries;
+    auto* focus = widget->GetFocusManager();
+    Collect(state,widget->client_view(), entries, focus ? focus->GetFocusedView() : nullptr);
+    std::vector<carbonyl_dialog_control> controls;
+    for (auto& entry : entries)
+      controls.push_back({entry.id, entry.kind, entry.label.c_str(), entry.value.c_str(), entry.flags});
+    if (auto* delegate = widget->widget_delegate()->AsDialogDelegate()) {
+      auto* ok = delegate->GetOkButton();
+      auto* default_button = delegate->GetDefaultDialogButton()==static_cast<int>(ui::mojom::DialogButton::kCancel)
+          ? delegate->GetCancelButton() : ok;
+      for (auto& control : controls) {
+        if (ok && control.id == Track(state,ok)) control.flags |= 16;
+        if ((!focus || !focus->GetFocusedView()) && default_button && control.id==Track(state,default_button)) control.flags|=8;
+      }
+    }
+    auto title = base::UTF16ToUTF8(widget->widget_delegate()->GetWindowTitle());
+    if (title.empty()) title = "Chromium";
+    renderer->ShowDialog(state.serial_, title, controls);
+    state.shown_ = true;
+  }
+  AnyWidgetObserver observer_;
+  base::RepeatingTimer timer_;
+  std::map<carbonyl::Renderer*, State> states_;
+  std::vector<base::WeakPtr<Widget>> pending_;
+  uint64_t serial_ = 0;
+};
+}  // namespace views
