+class NativePermissionPrompt final : public permissions::PermissionPrompt {
+ public:
+  NativePermissionPrompt(content::WebContents* contents, Delegate* delegate)
+      : state_(std::make_shared<State>()) {
+    state_->delegate = delegate->GetWeakPtr();
+    state_->precise=delegate->GetInitialGeolocationAccuracySelection()==GeolocationAccuracy::kPrecise;
+    for (const auto& request:delegate->Requests())
+      if(request->GetContentSettingsType()==ContentSettingsType::GEOLOCATION_WITH_OPTIONS)state_->geolocation=true;
+    owner_ = std::make_unique<Owner>();
+    owner_->delegate = std::make_unique<views::DialogDelegate>();
+    auto* dialog = owner_->delegate.get();
+    dialog->SetOwnershipOfNewWidget(views::Widget::InitParams::CLIENT_OWNS_WIDGET);
+    auto contents_view = std::make_unique<views::View>();
+    auto* body = contents_view.get();
+    dialog->SetTitle(u"Uprawnienia witryny");
+    dialog->SetButtonLabel(ui::mojom::DialogButton::kOk, u"Zezwól");
+    dialog->SetButtonLabel(ui::mojom::DialogButton::kCancel, u"Odmów");
+    dialog->SetDefaultButton(static_cast<int>(ui::mojom::DialogButton::kCancel));
+    body->SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kVertical, gfx::Insets(16), 8));
+    body->AddChildView(std::make_unique<views::Label>(
+        base::UTF8ToUTF16(delegate->GetRequestingOrigin().spec())));
+    for (const auto& request : delegate->Requests())
+      body->AddChildView(std::make_unique<views::Label>(request->GetMessageTextFragment()));
+    if(state_->geolocation) {
+      auto* precise=body->AddChildView(std::make_unique<views::Checkbox>(u"Dokładna lokalizacja"));
+      precise->SetChecked(state_->precise);
+      precise->SetCallback(base::BindRepeating([](std::shared_ptr<State> state,views::Checkbox* checkbox){state->precise=checkbox->GetChecked();},state_,base::Unretained(precise)));
+    }
+    dialog->SetContentsView(std::move(contents_view));
+    dialog->SetAcceptCallback(base::BindOnce(&Decide, state_, 0));
+    dialog->SetCancelCallback(base::BindOnce(&Decide, state_, 1));
+    dialog->SetCloseCallback(base::BindOnce(&Decide, state_, 2));
+    auto* widget = views::DialogDelegate::CreateDialogWidget(
+        dialog, contents->GetTopLevelNativeWindow(), contents->GetTopLevelNativeWindow());
+    owner_->widget.reset(widget);
+    widget_ = widget->GetWeakPtr();
+    delegate->SetPromptShown();
+    widget->Show();
+  }
+  ~NativePermissionPrompt() override {
+    state_->resolved = true;
+    if (widget_ && !widget_->IsClosed()) widget_->Close();
+    // Permission decisions may destroy the prompt from inside a button's
+    // callback. Dispose of the client-owned Widget/delegate after it returns.
+    base::SingleThreadTaskRunner::GetCurrentDefault()->DeleteSoon(FROM_HERE, std::move(owner_));
+  }
+  bool UpdateAnchor() override { return true; }
+  TabSwitchingBehavior GetTabSwitchingBehavior() override { return kDestroyPromptButKeepRequestPending; }
+  permissions::PermissionPromptDisposition GetPromptDisposition() const override {
+    return permissions::PermissionPromptDisposition::CUSTOM_MODAL_DIALOG;
+  }
+  bool IsAskPrompt() const override { return true; }
+  std::optional<gfx::Rect> GetViewBoundsInScreen() const override {
+    return widget_ ? std::optional(widget_->GetWindowBoundsInScreen()) : std::nullopt;
+  }
+  std::vector<permissions::ElementAnchoredBubbleVariant> GetPromptVariants() const override { return {}; }
+  std::optional<permissions::feature_params::PermissionElementPromptPosition> GetPromptPosition() const override {
+    return std::nullopt;
+  }
+ private:
+  struct Owner {
+    std::unique_ptr<views::DialogDelegate> delegate;
+    std::unique_ptr<views::Widget> widget;
+  };
+  std::unique_ptr<Owner> owner_;
+  struct State {base::WeakPtr<Delegate> delegate;bool resolved=false,geolocation=false,precise=false;};
+  static void Decide(std::shared_ptr<State> state, int action) {
+    if (state->resolved || !state->delegate) return;
+    state->resolved = true;
+    auto delegate=state->delegate;
+    delegate->SetDecisionTime();
+    PromptOptions options=std::monostate();
+    if(state->geolocation)options=GeolocationPromptOptions{.selected_accuracy=state->precise?GeolocationAccuracy::kPrecise:GeolocationAccuracy::kApproximate};
+    if (action==0) delegate->Accept(options);
+    else if (action==1) delegate->Deny(options);
+    else delegate->Dismiss(options);
+  }
+  std::shared_ptr<State> state_;
+  base::WeakPtr<views::Widget> widget_;
+};
+}
+std::unique_ptr<permissions::PermissionPrompt> CreateNativePermissionPrompt(
+    content::WebContents* contents, permissions::PermissionPrompt::Delegate* delegate) {
+  return std::make_unique<NativePermissionPrompt>(contents, delegate);
+}
+}
