+void WebLocalFrameImpl::PaintCarbonylText(SkCanvas* canvas) {
+  if (auto* view = GetFrame()->View()) {
+    // Replay text before CSS layers rasterize it. The graphical surface retains
+    // the actual filters, opacity and backdrop effects; native terminal text
+    // needs the same transforms/clips without an intermediate pixel-only layer.
+    cc::PlaybackParams params;
+    params.callbacks.convert_op_callback = base::BindRepeating(
+        [](const cc::PaintOp& op) -> const cc::PaintOp* {
+          static const cc::SaveOp save;
+          switch (op.GetType()) {
+            case cc::PaintOpType::kSaveLayer:
+            case cc::PaintOpType::kSaveLayerAlpha:
+            case cc::PaintOpType::kSaveLayerFilters:
+              return &save;
+            default:
+              return &op;
+          }
+        });
+    view->GetPaintRecord().Playback(canvas, params);
+  }
+}
