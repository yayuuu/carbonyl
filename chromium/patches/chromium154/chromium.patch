 void RenderFrameImpl::DidCreateDocumentElement() {
+  if (initialized_ && GetLocalRootWebFrameWidget()) {
+  // Cross-document navigation resets the BrowserInterfaceBroker and can
+  // replace the frame's compositor. Rebind both native text and scroll metadata
+  // to the current document/widget, rather than retaining the about:blank pipe.
+  if (render_callback_) *render_callback_=nullptr;
+  if (carbonyl_render_service_receiver_.is_valid()) {
+    GetBrowserInterfaceBroker().GetInterface(std::move(carbonyl_render_service_receiver_));
+  } else {
+    carbonyl_render_service_.reset();
+    GetBrowserInterfaceBroker().GetInterface(carbonyl_render_service_.BindNewPipeAndPassReceiver());
+  }
+  if (base::CommandLine::ForCurrentProcess()->HasSwitch("carbonyl-b64-text")) {
+    setenv("carbonyl_b64_text", "true", 1);
+  }
+
+  auto* host = GetLocalRootWebFrameWidget()->LayerTreeHost();
+  mojo::Remote<carbonyl::mojom::ScrollService> scroll_service;
+  GetBrowserInterfaceBroker().GetInterface(scroll_service.BindNewPipeAndPassReceiver());
+  auto renderer = std::make_shared<carbonyl::RendererService>(frame_, std::move(scroll_service));
+
+  render_callback_ = std::make_shared<std::function<bool()>>(
+    [this, renderer]() -> bool {
+      if (!IsMainFrame() || IsHidden() || carbonyl::Bridge::BitmapMode()) {
+        return false;
+      }
+
+      renderer->ReportScroll();
+      size_t width = frame_->DocumentSize().width();
+      size_t height = frame_->VisibleContentRect().height();
+      std::vector<carbonyl::mojom::TextDataPtr> data;
+
+      frame_->PaintCarbonylText(renderer->BeginPaint(width, height));
+
+      renderer->Swap(data);
+      carbonyl_render_service_->DrawText(std::move(data));
+
+      return true;
+    }
+  );
+
+  host->ObserveTerminalRender(render_callback_);
+  }
   for (auto& observer : observers_) {
     observer.DidCreateDocumentElement();
   }
